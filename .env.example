# Copy to .env and fill in. .env is git-ignored and must stay that way.

DB_URL=jdbc:postgresql://localhost:5432/app
DB_USERNAME=app_user
DB_PASSWORD=

# The role that owns the schema and runs the migrations — see deploy/setup-migrator.sh.
# Leave both blank on a local database where one role owns everything.
FLYWAY_USER=app_migrator
FLYWAY_PASSWORD=

SERVER_PORT=8081

# The token the dashboard sends on X-Auth-Token. Generate one: openssl rand -hex 24
APP_AUTH_TOKEN=
