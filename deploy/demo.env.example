# Copy to demo.env (staging) — git-ignored, chmod 600.
#
# Staging is a separate database and a separate jar. Sharing either with production is how a
# deploy takes down the environment it was supposed to protect. Anything that reaches the
# outside world — a bot poller, an outbound webhook, a scheduled notifier — stays OFF here,
# because two instances on one credential collide.
DB_URL=jdbc:postgresql://localhost:5432/app_demo
DB_USERNAME=app_demo_user
DB_PASSWORD=
FLYWAY_USER=app_demo_migrator
FLYWAY_PASSWORD=
SERVER_PORT=8083
APP_AUTH_TOKEN=demo
